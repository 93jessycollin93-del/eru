+++ b/src/test/zombie-survival.test.tsx
@@ -0,0 +1,178 @@
+import { existsSync, readdirSync, readFileSync } from "node:fs";
+import path from "node:path";
+import { act, cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { MemoryRouter, Route, Routes } from "react-router-dom";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { resolveRoute } from "@/lib/routeManifest";
+import { NAV_PAGES } from "@/lib/navBar/catalog";
+import ZombieSurvival, { GAME_SRC, GAME_TITLE, SAVE_ANSWER, SAVE_REQUEST } from "@/pages/ZombieSurvival";
+
+/**
+ * Zombie Survival is a separate game whose finished build ships in public/zombie-survival/ and is
+ * framed by /zombie-survival. Each way it can break is silent: a menu entry pointing nowhere, a
+ * build that never got copied in (the host answers with Jackie's own page instead of a 404), a
+ * build with absolute asset paths (they would load Jackie's /assets/), or a service worker that
+ * answers the frame with Jackie's shell. These pin each one.
+ */
+const root = path.resolve(__dirname, "../..");
+const read = (p: string) => readFileSync(path.join(root, p), "utf8");
+const buildDir = path.join(root, "public/zombie-survival");
+
+describe("where Zombie Survival lives in the app", () => {
+  it("is in Games & Worlds, right after CollinSurvivalCraft", () => {
+    const nav = read("src/components/SidebarNav.tsx");
+    const games = nav.slice(nav.indexOf('id: "games"'), nav.indexOf('id: "ops"'));
+    const hrefs = [...games.matchAll(/href:\s*"([^"]+)"/g)].map((m) => m[1]);
+    expect(hrefs).toContain("/zombie-survival");
+    expect(hrefs.indexOf("/zombie-survival")).toBe(hrefs.indexOf("/craft") + 1);
+  });
+
+  it("has a route the router serves, behind sign-in like the other games", () => {
+    expect(resolveRoute("/zombie-survival")?.alias).toBeFalsy();
+    expect(read("src/App.tsx")).toMatch(/path="\/zombie-survival"\s+element=\{<ProtectedRoute><ZombieSurvival \/><\/ProtectedRoute>\}/);
+  });
+
+  it("can be pinned to the nav bar with its own icon", () => {
+    expect(NAV_PAGES.find((p) => p.id === "zombie-survival")?.to).toBe("/zombie-survival");
+  });
+
+  it("ships the game's build, which is the page the frame expects", () => {
+    expect(existsSync(path.join(buildDir, "index.html")), "public/zombie-survival/index.html is missing — see docs/ZOMBIE_SURVIVAL.md").toBe(true);
+    const html = readFileSync(path.join(buildDir, "index.html"), "utf8");
+    expect(html).toContain(`<title>${GAME_TITLE}</title>`);
+    expect(`/zombie-survival/index.html`).toBe(GAME_SRC);
+  });
+
+  it("references its files relatively, so it never loads Jackie's own /assets/", () => {
+    const html = readFileSync(path.join(buildDir, "index.html"), "utf8");
+    const refs = [...html.matchAll(/(?:src|href)="([^"]+)"/g)].map((m) => m[1]).filter((r) => !/^(https?:|data:|#)/.test(r));
+    expect(refs.length).toBeGreaterThan(0);
+    for (const ref of refs) {
+      expect(ref.startsWith("/"), `${ref} is absolute`).toBe(false);
+      expect(existsSync(path.join(buildDir, ref)), `${ref} is referenced but not shipped`).toBe(true);
+    }
+  });
+
+  it("ships a build that answers the page's save requests", () => {
+    const js = readdirSync(path.join(buildDir, "assets"))
+      .filter((f) => f.endsWith(".js"))
+      .map((f) => readFileSync(path.join(buildDir, "assets", f), "utf8"))
+      .join("\n");
+    expect(js).toContain(SAVE_REQUEST);
+    expect(js).toContain(SAVE_ANSWER);
+  });
+
+  it("keeps the service worker from precaching the game or answering its frame with Jackie's shell", () => {
+    const config = read("vite.config.ts");
+    expect(config).toContain('"**/zombie-survival/**"');
+    expect(config).toContain("/^\\/zombie-survival\\//");
+  });
+});
+
+function renderPage() {
+  render(
+    <MemoryRouter initialEntries={["/zombie-survival"]}>
+      <Routes>
+        <Route path="/zombie-survival" element={<ZombieSurvival />} />
+        <Route path="/" element={<div>Jackie home</div>} />
+      </Routes>
+    </MemoryRouter>,
+  );
+  return screen.getByTitle(GAME_TITLE) as HTMLIFrameElement;
+}
+
+/** Fires the frame's load as if `title` is what the server sent. */
+function loadFrame(frame: HTMLIFrameElement, title: string) {
+  // jsdom never fetches the frame's src and leaves its document empty, so a title can't simply
+  // be assigned. Build the page the server would have sent.
+  const doc = frame.contentDocument!;
+  const html = doc.createElement("html");
+  html.innerHTML = `<head><title>${title}</title></head><body></body>`;
+  doc.replaceChildren(html);
+  vi.spyOn(frame.contentWindow!, "focus").mockImplementation(() => {}); // jsdom has no focus()
+  fireEvent.load(frame);
+}
+
+/** Captures the frame's save request and answers it as the game would. */
+function gameAnswers(frame: HTMLIFrameElement, answer: { saved: boolean; reason: string | null }) {
+  const win = frame.contentWindow!;
+  return vi.spyOn(win, "postMessage").mockImplementation((msg: unknown) => {
+    const req = msg as { type: string; id: number };
+    if (req.type !== SAVE_REQUEST) return;
+    queueMicrotask(() =>
+      window.dispatchEvent(new MessageEvent("message", { data: { type: SAVE_ANSWER, id: req.id, ...answer }, origin: window.location.origin, source: win })),
+    );
+  });
+}
+
+describe("the Zombie Survival page", () => {
+  afterEach(() => {
+    cleanup();
+    vi.restoreAllMocks();
+  });
+
+  it("frames the game's build and names the tab after it", () => {
+    const frame = renderPage();
+    expect(frame.getAttribute("src")).toBe(GAME_SRC);
+    expect(document.title).toBe(`${GAME_TITLE} · Jackie`);
+    expect(screen.getByText(`Loading ${GAME_TITLE}`)).toBeTruthy();
+  });
+
+  it("says the game is missing when the server answers with some other page, instead of booting Jackie inside herself", () => {
+    const frame = renderPage();
+    loadFrame(frame, "Jackie");
+    expect(screen.getByText("The game isn't in this build")).toBeTruthy();
+    expect(screen.queryByTitle(GAME_TITLE)).toBeNull();
+  });
+
+  it("asks the game to save before going back, and leaves once it has", async () => {
+    const frame = renderPage();
+    loadFrame(frame, GAME_TITLE);
+    const post = gameAnswers(frame, { saved: true, reason: null });
+    await act(async () => {
+      fireEvent.click(screen.getByTitle(/Back to Jackie/));
+    });
+    expect(post).toHaveBeenCalledWith(expect.objectContaining({ type: SAVE_REQUEST }), window.location.origin);
+    expect(await screen.findByText("Jackie home")).toBeTruthy();
+  });
+
+  it("stays and says why when the game won't save, until the player chooses to leave anyway", async () => {
+    const frame = renderPage();
+    loadFrame(frame, GAME_TITLE);
+    gameAnswers(frame, { saved: false, reason: "hunted" });
+    await act(async () => {
+      fireEvent.click(screen.getByTitle(/Back to Jackie/));
+    });
+    expect(await screen.findByText(/Something is hunting you/)).toBeTruthy();
+    expect(screen.queryByText("Jackie home")).toBeNull();
+    fireEvent.click(screen.getByText("Leave anyway"));
+    expect(screen.getByText("Jackie home")).toBeTruthy();
+  });
+
+  it("treats a game that never answers as unsaved rather than pretending it saved", async () => {
+    vi.useFakeTimers();
+    try {
+      const frame = renderPage();
+      loadFrame(frame, GAME_TITLE);
+      vi.spyOn(frame.contentWindow!, "postMessage").mockImplementation(() => {});
+      fireEvent.click(screen.getByLabelText("Restart the game"));
+      await act(async () => {
+        await vi.advanceTimersByTimeAsync(3000);
+      });
+      expect(screen.getByText(/didn't answer/)).toBeTruthy();
+      expect(screen.getByText("Restart anyway")).toBeTruthy();
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it("goes back straight away when there is no run to save", async () => {
+    const frame = renderPage();
+    loadFrame(frame, GAME_TITLE);
+    gameAnswers(frame, { saved: false, reason: "nothing" });
+    await act(async () => {
+      fireEvent.click(screen.getByTitle(/Back to Jackie/));
+    });
+    expect(await screen.findByText("Jackie home")).toBeTruthy();
+  });
+});
