--- /dev/null
+++ b/src/pages/ZombieSurvival.tsx
@@ -0,0 +1,370 @@
+import { useCallback, useEffect, useRef, useState, type MouseEvent } from "react";
+import { Link, useNavigate } from "react-router-dom";
+import { ArrowLeft, Biohazard, ExternalLink, Loader2, Maximize2, Minimize2, RotateCw, TriangleAlert, X } from "lucide-react";
+
+/**
+ * Zombie Survival, embedded whole.
+ *
+ * The game is its own project (a third-person survival game in an overrun town) and ships here
+ * as a finished build under /public/zombie-survival/, the same way /pc frames /public/pc-os/.
+ * It has no Supabase or account code: runs are saved in this browser's IndexedDB, per device.
+ * docs/ZOMBIE_SURVIVAL.md says how to refresh the build.
+ */
+export const GAME_SRC = "/zombie-survival/index.html";
+/** The game's own <title>. Anything else in the frame means its files are missing. */
+export const GAME_TITLE = "Zombie Survival";
+
+// The game answers these (its src/game/embedBridge.ts). Leaving this page destroys the frame,
+// and a save the game starts while it is being torn down may never commit, so every way out
+// this page offers asks the game to save first and waits for the answer.
+export const SAVE_REQUEST = "zombie-survival:save";
+export const SAVE_ANSWER = "zombie-survival:saved";
+const SAVE_TIMEOUT_MS = 2500;
+
+type SaveReason = "nothing" | "hunted" | "busy" | "failed" | "timeout" | null;
+type Exit = "back" | "restart";
+type Frame = "loading" | "ready" | "missing" | "away";
+
+/** Why a run would be lost, in words a player can act on. */
+const UNSAVED: Record<Exclude<SaveReason, "nothing" | null>, string> = {
+  hunted: "Something is hunting you, so the game won't save right now.",
+  busy: "You're in the middle of climbing or a job, so the game won't save right now.",
+  failed: "The browser refused to store the save (storage full or blocked).",
+  timeout: "The game didn't answer, so this run may not be saved.",
+};
+
+const VERB: Record<Exit, string> = { back: "Leave anyway", restart: "Restart anyway" };
+
+const finePointer = () => {
+  try {
+    return window.matchMedia("(any-pointer: fine)").matches;
+  } catch {
+    return true;
+  }
+};
+
+const iconButton =
+  "inline-flex h-8 w-8 items-center justify-center rounded-sm text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-40";
+
+const ZombieSurvival = () => {
+  const navigate = useNavigate();
+  const stageRef = useRef<HTMLDivElement>(null);
+  const frameRef = useRef<HTMLIFrameElement>(null);
+  const requestId = useRef(0);
+  const [frame, setFrame] = useState<Frame>("loading");
+  const [frameKey, setFrameKey] = useState(0);
+  const [slow, setSlow] = useState(false);
+  const [saving, setSaving] = useState<Exit | null>(null);
+  const [ask, setAsk] = useState<{ exit: Exit; reason: Exclude<SaveReason, "nothing" | null> } | null>(null);
+  const [awayUnsaved, setAwayUnsaved] = useState<SaveReason>(null);
+  const [fullscreen, setFullscreen] = useState(false);
+  const [touchNote, setTouchNote] = useState(() => !finePointer());
+
+  useEffect(() => {
+    const before = document.title;
+    document.title = `${GAME_TITLE} · Jackie`;
+    return () => {
+      document.title = before;
+    };
+  }, []);
+
+  useEffect(() => {
+    const onChange = () => setFullscreen(document.fullscreenElement === stageRef.current);
+    document.addEventListener("fullscreenchange", onChange);
+    return () => document.removeEventListener("fullscreenchange", onChange);
+  }, []);
+
+  // About 1 MB to fetch on a first visit: say so rather than spin silently.
+  useEffect(() => {
+    if (frame !== "loading") return;
+    setSlow(false);
+    const t = window.setTimeout(() => setSlow(true), 12000);
+    return () => window.clearTimeout(t);
+  }, [frame, frameKey]);
+
+  const onFrameLoad = () => {
+    const el = frameRef.current;
+    let title: string | null = null;
+    try {
+      title = el?.contentDocument?.title ?? null;
+    } catch {
+      title = null;
+    }
+    // A deploy without the game's files doesn't 404: the host answers with this app's own
+    // index.html, which would boot Jackie inside her own frame. Check what actually loaded.
+    if (title !== GAME_TITLE) {
+      setFrame("missing");
+      return;
+    }
+    setFrame("ready");
+    // Keys go where focus is; without this the first WASD press after opening does nothing.
+    el?.contentWindow?.focus();
+  };
+
+  /** Asks the game to save; resolves with why it didn't, or null once it has. */
+  const requestSave = useCallback((): Promise<SaveReason> => {
+    const target = frameRef.current?.contentWindow;
+    if (frame !== "ready" || !target) return Promise.resolve("nothing");
+    const id = ++requestId.current;
+    return new Promise((resolve) => {
+      const done = (reason: SaveReason) => {
+        window.removeEventListener("message", onMessage);
+        window.clearTimeout(timer);
+        resolve(reason);
+      };
+      const onMessage = (e: MessageEvent) => {
+        if (e.source !== target || e.origin !== window.location.origin) return;
+        const data = e.data as { type?: unknown; id?: unknown; saved?: unknown; reason?: unknown } | null;
+        if (!data || data.type !== SAVE_ANSWER || data.id !== id) return;
+        done(data.saved === true ? null : ((data.reason as SaveReason) ?? "failed"));
+      };
+      const timer = window.setTimeout(() => done("timeout"), SAVE_TIMEOUT_MS);
+      window.addEventListener("message", onMessage);
+      target.postMessage({ type: SAVE_REQUEST, id }, window.location.origin);
+    });
+  }, [frame]);
+
+  const proceed = useCallback(
+    (exit: Exit) => {
+      setAsk(null);
+      if (exit === "back") navigate("/");
+      else {
+        setFrame("loading");
+        setFrameKey((k) => k + 1);
+      }
+    },
+    [navigate],
+  );
+
+  const leave = useCallback(
+    async (exit: Exit) => {
+      if (saving) return;
+      setAsk(null);
+      setSaving(exit);
+      const reason = await requestSave();
+      setSaving(null);
+      if (reason === null || reason === "nothing") proceed(exit);
+      else setAsk({ exit, reason });
+    },
+    [proceed, requestSave, saving],
+  );
+
+  const onBack = (e: MouseEvent<HTMLAnchorElement>) => {
+    // Let new-tab clicks through untouched; only a plain click leaves this page.
+    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+    e.preventDefault();
+    void leave("back");
+  };
+
+  const onOpenTab = (e: MouseEvent<HTMLAnchorElement>) => {
+    // The new tab opens straight away (a click is needed for that, and a save would take it
+    // past the browser's allowance); meanwhile this copy saves and steps aside, so two copies
+    // never take turns overwriting the same autosave. The new one takes seconds to start.
+    if (frame !== "ready") return;
+    void requestSave().then((reason) => {
+      setAwayUnsaved(reason === "nothing" ? null : reason);
+      setFrame("away");
+    });
+  };
+
+  const toggleFullscreen = async () => {
+    try {
+      if (document.fullscreenElement) await document.exitFullscreen();
+      else await stageRef.current?.requestFullscreen();
+    } catch {
+      // Some browsers (iPhone Safari) only put video in full screen; the button is hidden there.
+    }
+    frameRef.current?.contentWindow?.focus();
+  };
+
+  const status =
+    saving !== null ? "Saving…" : frame === "loading" ? "Loading…" : frame === "away" ? "Playing in another tab" : null;
+
+  return (
+    <div className="flex h-screen w-full flex-col bg-background">
+      <header className="flex flex-shrink-0 items-center gap-2 border-b border-border bg-sidebar px-3 py-1.5">
+        <Link
+          to="/"
+          onClick={onBack}
+          className="flex items-center gap-1.5 rounded-sm px-2 py-1 font-mono text-xs text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
+          title="Back to Jackie (saves your run first)"
+        >
+          <ArrowLeft size={14} aria-hidden />
+          Jackie
+        </Link>
+        <div className="flex min-w-0 items-center gap-2">
+          <Biohazard size={14} className="flex-shrink-0 text-primary" aria-hidden />
+          <h1 className="truncate font-mono text-xs uppercase tracking-widest text-foreground">{GAME_TITLE}</h1>
+          <span className="hidden truncate font-mono text-[10px] text-muted-foreground lg:inline">
+            · third-person survival · saves stay on this device
+          </span>
+        </div>
+        <div className="flex-1" />
+
+        {status && (
+          <span className="flex items-center gap-1.5 font-mono text-[10px] text-muted-foreground" aria-live="polite">
+            {(saving !== null || frame === "loading") && <Loader2 size={12} className="animate-spin" aria-hidden />}
+            {status}
+          </span>
+        )}
+        {/* Labelled, not just an icon: full screen is also how to play without the app's
+            floating nav bar over the game's HUD. */}
+        {document.fullscreenEnabled && (
+          <button
+            type="button"
+            onClick={() => void toggleFullscreen()}
+            className="inline-flex h-8 items-center gap-1.5 rounded-sm px-2 font-mono text-[11px] text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-40"
+            disabled={frame !== "ready"}
+            title={fullscreen ? "Leave full screen (Esc)" : "Play in full screen"}
+            aria-label={fullscreen ? "Leave full screen" : "Full screen"}
+          >
+            {fullscreen ? <Minimize2 size={14} aria-hidden /> : <Maximize2 size={14} aria-hidden />}
+            <span className="hidden md:inline">{fullscreen ? "Exit full screen" : "Full screen"}</span>
+          </button>
+        )}
+        <button
+          type="button"
+          onClick={() => void leave("restart")}
+          className={iconButton}
+          disabled={saving !== null || frame === "loading"}
+          title="Restart the game (saves your run first)"
+          aria-label="Restart the game"
+        >
+          <RotateCw size={14} />
+        </button>
+        <a
+          href={GAME_SRC}
+          target="_blank"
+          rel="noopener noreferrer"
+          onClick={onOpenTab}
+          className={iconButton}
+          title="Open the game in its own tab"
+          aria-label="Open the game in its own tab"
+        >
+          <ExternalLink size={14} />
+        </a>
+      </header>
+
+      {ask && (
+        <div role="alert" className="flex flex-shrink-0 flex-wrap items-center gap-2 border-b border-destructive/40 bg-card px-3 py-2 text-xs">
+          <TriangleAlert size={14} className="flex-shrink-0 text-destructive" aria-hidden />
+          <span className="min-w-[12rem] flex-1 text-foreground">{UNSAVED[ask.reason]}</span>
+          <button
+            type="button"
+            onClick={() => proceed(ask.exit)}
+            className="rounded-sm border border-destructive/60 px-2.5 py-1 font-mono text-[11px] text-destructive hover:bg-destructive/10"
+          >
+            {VERB[ask.exit]}
+          </button>
+          <button
+            type="button"
+            onClick={() => {
+              setAsk(null);
+              frameRef.current?.contentWindow?.focus();
+            }}
+            className="rounded-sm border border-border px-2.5 py-1 font-mono text-[11px] hover:bg-secondary"
+          >
+            Keep playing
+          </button>
+        </div>
+      )}
+
+      {touchNote && (
+        <div className="flex flex-shrink-0 items-center gap-2 border-b border-border bg-card px-3 py-2 text-xs text-muted-foreground">
+          <TriangleAlert size={14} className="flex-shrink-0 text-primary" aria-hidden />
+          <span className="flex-1">
+            Zombie Survival is played with a keyboard and mouse. It opens on this device, but there are no touch
+            controls yet.
+          </span>
+          <button type="button" onClick={() => setTouchNote(false)} className={iconButton} aria-label="Dismiss">
+            <X size={14} />
+          </button>
+        </div>
+      )}
+
+      <div ref={stageRef} className="relative flex-1 bg-black">
+        {frame !== "missing" && frame !== "away" && (
+          <iframe
+            key={frameKey}
+            ref={frameRef}
+            src={GAME_SRC}
+            title={GAME_TITLE}
+            className={`absolute inset-0 h-full w-full border-0 transition-opacity duration-300 ${frame === "ready" ? "opacity-100" : "opacity-0"}`}
+            allow="fullscreen; gamepad; autoplay"
+            onLoad={onFrameLoad}
+          />
+        )}
+
+        {frame === "loading" && (
+          <div className="absolute inset-0 flex flex-col items-center justify-center gap-3 text-center">
+            <Biohazard size={36} className="animate-pulse text-primary" aria-hidden />
+            <p className="font-mono text-xs uppercase tracking-widest text-foreground">Loading {GAME_TITLE}</p>
+            <p className="max-w-xs text-xs text-muted-foreground">
+              {slow
+                ? "Still loading. The game is about 1 MB; on a slow connection the first visit takes a while."
+                : "Starting up…"}
+            </p>
+          </div>
+        )}
+
+        {frame === "missing" && (
+          <div role="alert" className="absolute inset-0 flex items-center justify-center p-6">
+            <div className="max-w-md space-y-3 rounded-md border border-border bg-card p-5 text-sm">
+              <div className="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-destructive">
+                <TriangleAlert size={14} aria-hidden /> The game isn't in this build
+              </div>
+              <p className="text-muted-foreground">
+                The server answered <code className="font-mono">{GAME_SRC}</code> with a different page, so the game's files
+                were not deployed with this version of the app. Rebuilding them is one command — see{" "}
+                <code className="font-mono">docs/ZOMBIE_SURVIVAL.md</code>.
+              </p>
+              <button
+                type="button"
+                onClick={() => {
+                  setFrame("loading");
+                  setFrameKey((k) => k + 1);
+                }}
+                className="inline-flex items-center gap-1.5 rounded-sm border border-border px-3 py-1.5 font-mono text-xs hover:bg-secondary"
+              >
+                <RotateCw size={12} aria-hidden /> Try again
+              </button>
+            </div>
+          </div>
+        )}
+
+        {frame === "away" && (
+          <div className="absolute inset-0 flex items-center justify-center p-6">
+            <div className="max-w-sm space-y-3 text-center text-sm">
+              <ExternalLink size={28} className="mx-auto text-primary" aria-hidden />
+              <p className="text-foreground">The game is open in its own tab.</p>
+              {awayUnsaved === null ? (
+                <p className="text-muted-foreground">
+                  This copy saved and stepped aside, so the two don't overwrite each other's autosave. Choose
+                  <span className="text-foreground"> Continue</span> there to pick up where you left off.
+                </p>
+              ) : (
+                <p className="text-muted-foreground">
+                  This copy stepped aside so the two don't overwrite each other's autosave, but it couldn't save
+                  first: {UNSAVED[awayUnsaved as Exclude<SaveReason, "nothing" | null>].toLowerCase()} The other tab
+                  starts from your last save.
+                </p>
+              )}
+              <button
+                type="button"
+                onClick={() => {
+                  setFrame("loading");
+                  setFrameKey((k) => k + 1);
+                }}
+                className="inline-flex items-center gap-1.5 rounded-sm border border-border px-3 py-1.5 font-mono text-xs hover:bg-secondary"
+              >
+                Play here instead
+              </button>
+            </div>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
+
+export default ZombieSurvival;
diff --git a/src/test/zombie-survival.test.tsx b/src/test/zombie-survival.test.tsx
