{
  "name": "Training Results To Squad Memory",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.data.passed == true) and (.trigger.data.similarity_score >= 0.9)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "BotTestRun"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "training_results_to_squad_memory",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncTrainingToSquadMemory",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncTrainingToSquadMemory"
  }
}