{
  "name": "CardUsageHistory",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-form description (max 1000 chars)"
    },
    "card_id": {
      "type": "string"
    },
    "card_name": {
      "type": "string"
    },
    "battle_history_id": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "tournament",
        "quick_match",
        "pvp_ladder",
        "ai_campaign",
        "training",
        "tutorial",
        "jackie_ai"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "win",
        "loss"
      ]
    },
    "opponent_name": {
      "type": "string"
    }
  },
  "required": [
    "card_name",
    "mode",
    "result"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}