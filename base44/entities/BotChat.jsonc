{
  "name": "BotChat",
  "type": "object",
  "properties": {
    "bot_id": {
      "type": "string",
      "description": "Owning OfflineBot id"
    },
    "bot_name": {
      "type": "string",
      "description": "Snapshot of bot name"
    },
    "title": {
      "type": "string",
      "description": "Conversation title"
    }
  },
  "required": [
    "bot_id",
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}