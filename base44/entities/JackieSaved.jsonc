{
  "name": "JackieSaved",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "tag": {
      "type": "string",
      "enum": [
        "code",
        "ui",
        "system",
        "bot",
        "strategy",
        "prompt",
        "conversation",
        "general"
      ]
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "code",
        "visual",
        "text",
        "system"
      ],
      "default": "text"
    },
    "language": {
      "type": "string"
    },
    "folder": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}